rules_version = '2';

// Regras de segurança do Firestore para o Drawn Love.
// Cole este conteúdo em: Firebase Console > Firestore Database > Regras > Publicar.
//
// Resumo:
// - Só quem confirmou o e-mail enxerga outras pessoas, manda redesenhos e conversa.
// - Cada pessoa só altera os próprios dados.
// - Match só existe se a outra pessoa aprovou o redesenho.
// - Tamanhos limitados (mensagens, textos e desenhos) para ninguém lotar o banco.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // TESTE: confirmação de e-mail desligada, basta estar logado.
    // Para exigir e-mail confirmado de novo, troque a linha abaixo por:
    //   function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function verified() { return signedIn(); }
    function data() { return request.resource.data; }
    function str(v, limit) { return v is string && v.size() <= limit; }

    // ---------- Perfil público ----------
    // Ler outras pessoas: só com e-mail confirmado.
    // Escrever o próprio perfil: liberado logo após criar a conta (o cadastro salva antes da confirmação).
    match /users/{uid} {
      allow read: if verified() || (signedIn() && me() == uid);
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['profile', 'head', 'seek', 'me', 'ready', 'profileDone', 'updatedAt'])
        && (!('profile' in data()) || (data().profile is map
            && str(data().profile.get('name', ''), 40)
            && str(data().profile.get('bio', ''), 2000)))
        && (!('ready' in data()) || data().ready == false || verified());
      allow delete: if false;
    }

    // ---------- Dados privados (respostas do cadastro, quem já passou) ----------
    match /private/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ---------- Redesenhos enviados ----------
    // O id é sempre "de_para"; só quem envia cria; só quem recebe responde (e só o campo status).
    match /likes/{id} {
      allow read: if verified() && (resource.data.from == me() || resource.data.to == me());
      allow create: if verified()
        && data().from == me()
        && data().to != me()
        && id == me() + '_' + data().to
        && data().status == 'pending'
        && str(data().fromName, 40)
        && data().sent is map
        && (!('image' in data().sent) || str(data().sent.image, 300000));   // desenho de até ~300 KB
      allow update: if verified()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && data().diff(resource.data).affectedKeys().hasOnly(['status'])
        && data().status in ['accepted', 'declined'];
      allow delete: if false;
    }

    // ---------- Conversas ----------
    match /matches/{id} {
      function members() { return resource.data.users; }
      function other(users) { return users[0] == me() ? users[1] : users[0]; }

      allow read: if verified() && me() in members();

      // Só cria o match quem APROVOU o redesenho da outra pessoa.
      allow create: if verified()
        && data().users is list && data().users.size() == 2
        && me() in data().users
        && id == data().users[0] + '_' + data().users[1]
        && get(/databases/$(database)/documents/likes/$(other(data().users) + '_' + me())).data.status == 'accepted';

      // Quem está na conversa atualiza sequência, última mensagem e o demo da galeria,
      // mas não pode trocar quem participa.
      allow update: if verified()
        && me() in members()
        && data().users == resource.data.users;

      allow delete: if false;

      match /messages/{msg} {
        function inMatch() { return me() in get(/databases/$(database)/documents/matches/$(id)).data.users; }
        allow read: if verified() && inMatch();
        allow create: if verified() && inMatch()
          && data().from == me()
          && data().keys().hasOnly(['from', 'text', 'at', 'kind'])
          && (!('kind' in data()) || data().kind == 'system')
          && data().text is string && data().text.size() > 0 && data().text.size() <= 1000
          && data().at is number;
        allow update, delete: if false;
      }

      // Jogos (Termo, Desenha e adivinha, Pokédle, Xadrez): só as duas pessoas do match.
      // Quem cria é quem está logado; ninguém troca o tipo do jogo depois; nada é apagado.
      match /games/{game} {
        function inMatch() { return me() in get(/databases/$(database)/documents/matches/$(id)).data.users; }
        allow read: if verified() && inMatch();
        allow create: if verified() && inMatch()
          && data().createdBy == me()
          && data().type in ['termo', 'desenho', 'pokedle', 'xadrez'];
        allow update: if verified() && inMatch()
          && data().type == resource.data.type
          && data().createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      // Galeria: só as duas pessoas veem; cada uma envia e apaga só as próprias fotos.
      // photos = miniatura (até ~60 KB); photoData = foto comprimida (até ~900 KB, limite do Firestore é 1 MB).
      match /photos/{photo} {
        function inMatch() { return me() in get(/databases/$(database)/documents/matches/$(id)).data.users; }
        allow read: if verified() && inMatch();
        allow create: if verified() && inMatch()
          && data().from == me()
          && data().keys().hasOnly(['from', 'thumb', 'w', 'h', 'at'])
          && str(data().thumb, 80000) && data().thumb[0:23] == 'data:image/jpeg;base64,';
        allow delete: if verified() && inMatch() && resource.data.from == me();
        allow update: if false;
      }
      match /photoData/{photo} {
        function inMatch() { return me() in get(/databases/$(database)/documents/matches/$(id)).data.users; }
        allow read: if verified() && inMatch();
        allow create: if verified() && inMatch()
          && data().from == me()
          && data().keys().hasOnly(['from', 'data'])
          && str(data().data, 950000) && data().data[0:23] == 'data:image/jpeg;base64,';
        allow delete: if verified() && inMatch() && resource.data.from == me();
        allow update: if false;
      }
    }
  }
}
