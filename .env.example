# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Firebase Console > Configurações do projeto > Seus apps > App da Web > Configuração).
# No Netlify, cadastre as mesmas variáveis em: Site configuration > Environment variables.
# Sem essas variáveis o app roda em "modo local" (dados só no navegador).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
